<Application x:Class="Sampler.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sampler"
             xmlns:vm="clr-namespace:Sampler.ViewModels"
             xmlns:menu="clr-namespace:Sampler.ViewModels.Menu"
             xmlns:views="clr-namespace:Sampler.Views"
             xmlns:models="clr-namespace:Sampler.Models"
             xmlns:codexConv="clr-namespace:Sampler.Codex.AudioUI.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ✅ Twój konwerter -->
            <codexConv:KnobToAngleConverter x:Key="KnobToAngleConverter" />

            <!-- ✅ Twoje słowniki -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/DataTemplates.xaml"/>
                <ResourceDictionary Source="/Views/DataTemplates.Effect.xaml"/>
                <ResourceDictionary Source="/Themes/Styles.xaml"/>
                <ResourceDictionary Source="/Themes/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>

</Application>
