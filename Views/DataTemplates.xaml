<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Sampler.Views"
                    xmlns:vm="clr-namespace:Sampler.ViewModels"
                    xmlns:vmenu="clr-namespace:Sampler.ViewModels.Menu">


    <DataTemplate DataType="{x:Type vmenu:MenuFileViewModel}">
        <views:MenuFileView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vmenu:MenuPlayerViewViewModel}">
        <views:MenuPlayerView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vmenu:MenuGeneratorViewModel}">
        <views:MenuGeneratorView/>
    </DataTemplate>


</ResourceDictionary>