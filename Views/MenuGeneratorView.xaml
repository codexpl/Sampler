<UserControl x:Class="Sampler.Views.MenuGeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="500"
             Height="300">
    <StackPanel>
        <TextBlock Text="Generator" FontWeight="Bold" />
        <TextBox Width="100" Text="{Binding Frequency}" />
        <TextBox Width="100" Text="{Binding Duration}" />
        <Button Content="Generate" Command="{Binding GenerateCommand}" />
    </StackPanel>
</UserControl>
