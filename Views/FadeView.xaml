<UserControl x:Class="Sampler.Views.FadeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <StackPanel Margin="20">
        <TextBlock Text="Fade Effect" Foreground="White" FontSize="16" Margin="0,0,0,10"/>
        <Button Content="Fade In" Command="{Binding FadeInCommand}" Margin="0,5,0,0"/>
        <Button Content="Fade Out" Command="{Binding FadeOutCommand}" Margin="0,5,0,0"/>
    </StackPanel>


</UserControl>
