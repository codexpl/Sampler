<UserControl x:Class="Sampler.Views.FadeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">
        <TextBlock Text="Fade Effect" Foreground="White" FontSize="16" Margin="0,0,0,10"/>
        <ComboBox SelectedItem="{Binding FadeType}" Margin="0,0,0,10">
            <ComboBoxItem Content="Fade In"/>
            <ComboBoxItem Content="Fade Out"/>
        </ComboBox>
        <TextBox Text="{Binding DurationSeconds}" Width="100" Margin="0,0,0,10" />
        <Button Content="Zastosuj" Command="{Binding ApplyFadeCommand}"/>
    </StackPanel>
</UserControl>
