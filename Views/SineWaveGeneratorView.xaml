<UserControl x:Class="Sampler.Views.SineWaveGeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    
    <StackPanel Height="98">
        <Label Content="Frequency" HorizontalAlignment="Center" Foreground="White" FontSize="7" Margin="0,0,0,1"/>
        <TextBox Text="{Binding Frequency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
             Width="120"/>

        <Label Content="Duration ( sound pixels )" HorizontalAlignment="Center" Foreground="White" FontSize="7" Margin="0,5,0,1"/>
        <TextBox Text="{Binding Duration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
             Width="120"/>

        <Button Content="Generuj" Command="{Binding GenerateSineCommand}" 
            FontFamily="Simplex" FontWeight="Bold" FontSize="9"/>

    </StackPanel>
</UserControl>
