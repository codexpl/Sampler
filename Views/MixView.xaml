<UserControl x:Class="Sampler.Views.MixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Sampler.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Button Content="Load file source" HorizontalAlignment="Left" Margin="40,41,0,0" VerticalAlignment="Top" Width="85" 
                Command="{Binding LoadSourceCommand}"/>
        <Button x:Name="ButtonPlaySource" Content="Play" HorizontalAlignment="Left" Margin="140,40,0,0" VerticalAlignment="Top" 
                IsEnabled="{Binding IsSourceLoaded}"
                Command="{Binding PlaySourceCommand}"/>
        
        <Button Content="Load file destination" HorizontalAlignment="Left" Margin="40,80,0,0" VerticalAlignment="Top" Width="85" 
                Command="{Binding LoadDestinationCommand}"/>
        <Button x:Name="ButtonPlayDestination" Content="Play" HorizontalAlignment="Left" Margin="140,80,0,0" VerticalAlignment="Top" 
                IsEnabled="{Binding IsDestinationLoaded}"
                Command="{Binding PlayDestinationCommand}"/>

        <Button Content="Mix" HorizontalAlignment="Left" Margin="40,120,0,0" VerticalAlignment="Top" Width="85" 
                Command="{Binding MixCommand}"/>
        <Button x:Name="ButtonPlayMix" Content="Play" HorizontalAlignment="Left" Margin="140,120,0,0" VerticalAlignment="Top" IsEnabled="False"
                Command="{Binding PlayMixCommand}"/>


        <Button Content="Play"
        Margin="40,160,0,0" 
        VerticalAlignment="Top" 
        Width="85"
        Command="{Binding PlaySourceCommand}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="Background" Value="LightGray"/>
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="DarkGray"/>
                            <Setter Property="Background" Value="Gainsboro"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>


    </Grid>
</UserControl>
