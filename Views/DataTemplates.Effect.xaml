<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Sampler.Views"
                    xmlns:vm="clr-namespace:Sampler.ViewModels"
                    xmlns:vmenu="clr-namespace:Sampler.ViewModels.Menu">


    <DataTemplate DataType="{x:Type vm:GainViewModel}">
        <views:GainView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SineWaveGeneratorViewModel}">
        <views:SineWaveGeneratorView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FadeViewModel}">
        <views:FadeView/>
    </DataTemplate>

</ResourceDictionary>