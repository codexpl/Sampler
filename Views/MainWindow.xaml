<Window x:Class="Sampler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sampler"
        mc:Ignorable="d"
        Title="S a m p L 3 R" 
        Height="450" 
        Width="800">




    <Window.Resources>
        <Style TargetType="MenuItem">
            <Setter Property="FontSize"     Value="8"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Padding"      Value="5,2"/>
            <Setter Property="Margin"       Value="2"/>
            <Setter Property="Background"   Value="Azure"/>
        </Style>

        <!--  resources dictionary 
        <ResourceDictionary xmlns:v="clr-namespace:TwojaAplikacja.Views">

            <DataTemplate DataType="{x:Type vm:ViewModels}">
                <v:TabAView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:TabBViewModel}">
                <v:TabBView/>
            </DataTemplate>

        </ResourceDictionary>
        -->
        
    </Window.Resources>
   
    
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Menu -->
            <RowDefinition Height="*" />
            <!-- Reszta UI -->
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Open"    Command="{Binding MenuFile.OpenCommand}" />
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="_Undo"    Command="{Binding Menu.UndoCommand}" />
            </MenuItem>
            <MenuItem Header="Player">
                <MenuItem Header="_Play"    Command="{Binding MenuPlayer.PlayCommand}" />
            </MenuItem>
            <MenuItem Header="Generator">
                <MenuItem Header="SineWave"  Command="{Binding MenuGenerator.SineWaveCommand}" />
            </MenuItem>
        </Menu>

        <!-- Tu np. RichTextBox, ListView, itd. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="37*"/>
                <ColumnDefinition Width="123*"/>
            </Grid.ColumnDefinitions>
            <RichTextBox x:Name="LogBox" Margin="150,0,10,10" FontWeight="Bold" FontSize="9" Grid.Column="1" >
                <FlowDocument>
                    <Paragraph>
                        <Run Text=""/>
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>
            <!-- Twoje komponenty -->
        </Grid>

        <!-- Tabela próbek -->
        <DataGrid Grid.Row="1"
              Width="300"
              ItemsSource="{Binding Samples}"
              AutoGenerateColumns="False"
              HeadersVisibility="Column"
              CanUserAddRows="False"
              IsReadOnly="True"
              Margin="14,5,486,4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#"      Binding="{Binding Index}"       Width="100"/>
                <DataGridTextColumn Header="Left"   Binding="{Binding Left}"        Width="100"/>
                <DataGridTextColumn Header="Right"  Binding="{Binding Right}"       Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        
        
    </Grid>
</Window>
