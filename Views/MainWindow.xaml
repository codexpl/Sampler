<Window x:Class="Sampler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Sampler.Views"
        Title="Sampler" Height="600" Width="800">

    <Grid>
        <!-- Definicja wierszy -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Pasek menu -->
            <RowDefinition Height="Auto"/>
            <!-- Pasek przycisków -->
            <RowDefinition Height="*"/>
            <!-- Dynamiczny widok -->
            <RowDefinition Height="150"/>
            <!-- Log -->
        </Grid.RowDefinitions>

        <!-- Pasek menu -->
        <Menu Grid.Row="0" Background="#333" Foreground="White">
            <MenuItem Header="_File">
                <MenuItem Header="Open" Command="{Binding FileOpenCommand}" />
                <MenuItem Header="Save" Command="{Binding FileSaveCommand}" />
            </MenuItem>
            <MenuItem Header="_Player">
                <MenuItem Header="Play" Command="{Binding PlayerPlayCommand}" />
                <MenuItem Header="Stop" Command="{Binding PlayerStopCommand}" />
            </MenuItem>
        </Menu>

        <!-- Pasek przycisków do przełączania widoków -->
        <Border Grid.Row="1" Background="#444" Padding="5">
            <StackPanel Orientation="Horizontal">
                <Button Content="File" Command="{Binding ShowFileCommand}" Margin="5"/>
                <Button Content="Player" Command="{Binding ShowPlayerCommand}" Margin="5"/>
                <Button Content="Generator" Command="{Binding ShowEditorCommand}" Margin="5"/>
            </StackPanel>
        </Border>

        <!-- Dynamiczny widok -->
        <Border Grid.Row="2" Margin="10" Padding="10" CornerRadius="8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,1">
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <!-- Tu wstawiany jest widok (File/Player/Generator) -->
            <ContentControl Content="{Binding CurrentMenu}" />
        </Border>

        <!-- Log zawsze na dole -->
        <RichTextBox x:Name="LogBox" Grid.Row="3" Margin="10" IsReadOnly="True">
            <FlowDocument>
                <Paragraph>
                    <Run Text="Log output..."/>
                </Paragraph>
            </FlowDocument>
        </RichTextBox>
    </Grid>
</Window>
