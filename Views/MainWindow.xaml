<Window x:Class="Sampler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Sampler.Views"
        Title="Sampler" Height="800" Width="1200">

    <Grid>
        <!-- Definicja wierszy -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Pasek menu -->
            <RowDefinition Height="Auto"/>
            <!-- Pasek przycisków -->
            <RowDefinition Height="*"/>
            <!-- Dynamiczny widok -->
            <RowDefinition Height="150"/>
            <!-- Log -->
        </Grid.RowDefinitions>



        <!-- Dynamiczny widok -->
        <Border Grid.Row="2" Margin="10" Padding="10" CornerRadius="8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,1">
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <!-- Tu wstawiany jest widok (File/Player/Generator) -->
            <ContentControl Content="{Binding CurrentMenu}" />
        </Border>


        <!-- Log zawsze na dole -->
        <RichTextBox x:Name="LogBox" Grid.Row="3" Margin="10,31,10,10" IsReadOnly="True">
            <FlowDocument>
                <Paragraph>
                    <Run Text="Log output..."/>
                </Paragraph>
            </FlowDocument>
        </RichTextBox>
        <Button Content="Play" HorizontalAlignment="Left" Margin="10,631,0,0" Grid.Row="2" 
                VerticalAlignment="Top" Width="130" Height="26" Grid.RowSpan="2" 
                Command="{Binding  PlayCommand}"/>
        <Button Content="Stop" HorizontalAlignment="Left" Margin="160,631,0,0" Grid.Row="2" 
                VerticalAlignment="Top" Width="130" Height="26" Grid.RowSpan="2" 
                Command="{Binding StopCommand}"/>
        <Button Content="Pause" HorizontalAlignment="Left" Margin="310,631,0,0" Grid.Row="2" 
                VerticalAlignment="Top" Width="130" Height="26" Grid.RowSpan="2" 
                Command="{Binding PauseCommand}"/>
        <Button Content="Rwd" HorizontalAlignment="Left" Margin="460,631,0,0" Grid.Row="2" 
                VerticalAlignment="Top" Width="130" Height="26" Grid.RowSpan="2" 
                Command="{Binding RewindCommand}"/>
        <Button Content="Fwd" HorizontalAlignment="Left" Margin="610,631,0,0" Grid.Row="2" 
                VerticalAlignment="Top" Width="130" Height="26" Grid.RowSpan="2" 
                Command="{Binding ForwardCommand}"/>
    </Grid>
</Window>
