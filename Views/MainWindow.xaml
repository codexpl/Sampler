<Window x:Class="Sampler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sampler"
        xmlns:views="clr-namespace:Sampler.Views"
        xmlns:vm="clr-namespace:Sampler.ViewModels"
        mc:Ignorable="d"
        Title="S a m p L 3 R" 
        Height="450" 
        Width="800">



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- pasek menu -->
            <RowDefinition Height="Auto"/>
            <!-- pasek przycisków -->
            <RowDefinition Height="*"/>
            <!-- główna zawartość -->
            <RowDefinition Height="Auto"/>
            <!-- log -->
        </Grid.RowDefinitions>

        <!-- Pasek menu -->
        <Menu Grid.Row="0" Background="#333" Foreground="White">
            <MenuItem Header="_File">
                <MenuItem Header="Open" Command="{Binding FileOpenCommand}" />
                <MenuItem Header="Save" Command="{Binding FileSaveCommand}" />
            </MenuItem>

            <MenuItem Header="_Player">
                <MenuItem Header="Play" Command="{Binding PlayerPlayCommand}" />
                <MenuItem Header="Stop" Command="{Binding PlayerStopCommand}" />
            </MenuItem>
        </Menu>




        <!-- Pasek wyboru -->
        <Border Grid.Row="0" Background="#333" Padding="5">
            <StackPanel Orientation="Horizontal">
                <Button Content="File"      Command="{Binding ShowFileCommand}"         Margin="5"/>
                <Button Content="Player"    Command="{Binding ShowPlayerCommand}"       Margin="5"/>
                <Button Content="Generator" Command="{Binding ShowGeneratorCommand}"    Margin="5"/>
            </StackPanel>
        </Border>

        <!-- Dynamiczny widok -->
        <Border Grid.Row="1" Margin="10" Padding="10" CornerRadius="8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,1">
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <!-- Tu pojawi się widok zgodny z CurrentMenu -->
            <ContentControl Content="{Binding CurrentMenu}" />
        </Border>

        <!-- Log na dole -->
        <RichTextBox x:Name="LogBox" Grid.Row="2" Margin="10" Height="100">
            <FlowDocument>
                <Paragraph>
                    <Run Text="RichTextBox"/>
                </Paragraph>
            </FlowDocument>
        </RichTextBox>
    </Grid>


</Window>
