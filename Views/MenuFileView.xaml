<UserControl x:Class="Sampler.Views.MenuFileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Sampler.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="0,10,0,0">
        <Label Content="Menu File" HorizontalAlignment="Center" Margin="0,30,0,0" VerticalAlignment="Top" Width="740" Foreground="#FF121FE6"/>
        <Button Content="Open" HorizontalAlignment="Left" Margin="10,70,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.702,-0.627" Width="130" Height="31" Command="{Binding OpenCommand}" />
        <Button Content="Save" HorizontalAlignment="Left" Margin="151,70,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.702,-0.627" Width="130" Height="31" Command="{Binding SaveCommand}"/>
    </Grid>
</UserControl>
